{
  "schema_version": "1.0",
  "name": "skill-contracts",
  "cases": [
    {
      "id": "all-skills-frontmatter",
      "type": "frontmatter_glob",
      "glob": "skills/*/SKILL.md",
      "min_count": 11,
      "required_keys": [
        "name",
        "description"
      ]
    },
    {
      "id": "all-commands-frontmatter",
      "type": "frontmatter_glob",
      "glob": "commands/*.md",
      "min_count": 13,
      "required_keys": [
        "description"
      ]
    },
    {
      "id": "router-routes-subskills",
      "type": "text_contract",
      "path": "skills/novel-creator/SKILL.md",
      "required": [
        "skills/novel-project-planning/SKILL.md",
        "skills/novel-memory/SKILL.md",
        "skills/novel-review/SKILL.md",
        "skills/novel-publish/SKILL.md",
        "skills/novel-knowledge-ingestion/SKILL.md",
        "references/orchestrator.md",
        "不建立独立 skill"
      ]
    },
    {
      "id": "write-skill-step-order",
      "type": "text_contract",
      "path": "skills/novel-chapter-write/SKILL.md",
      "required": [
        "novel-creator-pro:context-agent",
        "只依据任务书起草 Pass 1",
        "writing_gate.py",
        "Pass 2 去 AI 稿",
        "novel-creator-pro:reviewer",
        "write_pipeline.py\" post"
      ],
      "ordered": [
        [
          "write_pipeline.py pre",
          "novel-creator-pro:context-agent"
        ],
        [
          "novel-creator-pro:context-agent",
          "只依据任务书起草 Pass 1"
        ],
        [
          "只依据任务书起草 Pass 1",
          "writing_gate.py"
        ],
        [
          "writing_gate.py",
          "Pass 2 去 AI 稿"
        ],
        [
          "Pass 2 去 AI 稿",
          "novel-creator-pro:reviewer"
        ],
        [
          "novel-creator-pro:reviewer",
          "write_pipeline.py\" post"
        ]
      ],
      "forbidden": [
        "跳过审计",
        "跳过 9 问",
        "免于审计"
      ]
    },
    {
      "id": "review-skill-json-first",
      "type": "text_contract",
      "path": "skills/novel-review/SKILL.md",
      "required": [
        "novel-creator-pro:reviewer",
        "review_result.py\" save",
        "review_result.py\" render",
        "chapter_NNN_review.json",
        "不得手改字段",
        "blocker"
      ]
    },
    {
      "id": "orchestrator-stage-order",
      "type": "text_contract",
      "path": "novel_creation_promax/references/orchestrator.md",
      "required": [
        "3.5 写作任务书",
        "5.5 结构化审稿",
        "context-agent",
        "reviewer",
        "writing_gate.py",
        "post_write_audit.py",
        "blocking_count>0"
      ],
      "ordered": [
        [
          "3.5 写作任务书",
          "4. PASS 1"
        ],
        [
          "5.5 结构化审稿",
          "6. 写后审计"
        ]
      ],
      "forbidden": [
        "跳过 PASS 1",
        "跳过写后审计"
      ]
    },
    {
      "id": "command-write-matches-chapter-skill",
      "type": "text_contract",
      "path": "commands/write.md",
      "required": [
        "write_pipeline.py pre",
        "context-agent",
        "Pass 1 剧情稿",
        "writing_gate.py",
        "Pass 2 去 AI 稿",
        "reviewer",
        "review_result.py",
        "write_pipeline.py post",
        "verify_project_integrity.py"
      ],
      "ordered": [
        [
          "write_pipeline.py pre",
          "context-agent"
        ],
        [
          "context-agent",
          "Pass 1 剧情稿"
        ],
        [
          "Pass 1 剧情稿",
          "writing_gate.py"
        ],
        [
          "writing_gate.py",
          "Pass 2 去 AI 稿"
        ],
        [
          "Pass 2 去 AI 稿",
          "reviewer"
        ],
        [
          "reviewer",
          "write_pipeline.py post"
        ],
        [
          "write_pipeline.py post",
          "verify_project_integrity.py"
        ]
      ],
      "forbidden": [
        "跳过审稿",
        "不使用 reviewer"
      ]
    },
    {
      "id": "mode-registry-matches-latest-flow",
      "type": "text_contract",
      "path": "novel_creation_promax/MODE_REGISTRY.md",
      "required": [
        "chapter_NNN_taskbook.md",
        "chapter_NNN_review.json",
        "context-agent",
        "reviewer",
        "结构化审稿",
        "review_result.py"
      ],
      "ordered": [
        [
          "### 5. 正文写作",
          "### 9. 审稿评估"
        ]
      ]
    },
    {
      "id": "commands-doc-writing-chain",
      "type": "text_contract",
      "path": "docs/COMMANDS.md",
      "required": [
        "每章链路",
        "写作任务书",
        "结构化审稿",
        "reviewer",
        "review_result.py",
        "blocking_count > 0"
      ]
    },
    {
      "id": "short-story-workflow-contract",
      "type": "text_contract",
      "path": "novel_creation_promax/references/short-story-workflow.md",
      "required": [
        "明确任务",
        "调研先行",
        "短篇写前检查",
        "先锁结局/谜底",
        "整篇审稿",
        "不得为了调用流水线伪造",
        "2800–3200"
      ]
    },
    {
      "id": "revision-backup-audit-contract",
      "type": "text_contract",
      "path": "skills/novel-revision/SKILL.md",
      "required": [
        "先保存原稿",
        "revision_queue.py",
        "write_pipeline.py post",
        "revision_history",
        "重新走审计链",
        "不自动发布"
      ]
    },
    {
      "id": "continuation-two-modes-contract",
      "type": "text_contract",
      "path": "skills/novel-continuation/SKILL.md",
      "required": [
        "模式 A：项目续写",
        "模式 B：片段续写",
        "续写交接",
        "接缝检查",
        "不伪造 seal"
      ]
    },
    {
      "id": "chapter-spec-schema-contract",
      "type": "text_contract",
      "path": "novel_creation_promax/references/chapter-spec-schema.md",
      "required": [
        "before_state",
        "after_state",
        "tension_curve",
        "result 不能等于 goal",
        "to-scene-plan"
      ]
    },
    {
      "id": "prompt-library-contract",
      "type": "text_contract",
      "path": "novel_creation_promax/references/prompt-library.md",
      "required": [
        "24 组提示词",
        "章节初稿",
        "反派设计",
        "16 维审核",
        "五条禁忌"
      ]
    },
    {
      "id": "ai-reality-contract",
      "type": "text_contract",
      "path": "knowledge_base/60_Platform/AI变现与平台治理现实.md",
      "required": [
        "纯 AI",
        "朱雀",
        "人脑定框架",
        "60 天"
      ]
    },
    {
      "id": "knowledge-governance-contract",
      "type": "text_contract",
      "path": "knowledge_base/KNOWLEDGE_GOVERNANCE.md",
      "required": [
        "一个主题只有一个主人",
        "一个数只有一个出处",
        "脚本只检查已写下的规则",
        "60 天",
        "改完必须验"
      ]
    }
  ]
}
