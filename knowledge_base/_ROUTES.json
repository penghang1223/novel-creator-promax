{
  "schema_version": "1.0",
  "description": "机器可读知识库路由。Markdown 版 _ROUTING.md 用于人读，本文件用于脚本生成 chapter knowledge pack。",
  "required": [
    {
      "key": "writing_constitution",
      "path": "novel_creation_promax/references/writing_constitution.md",
      "purpose": "写作宪法：红线、节奏、人物原则"
    },
    {
      "key": "quick_card",
      "path": "novel_creation_promax/references/写作速查卡.md",
      "purpose": "浓缩可执行规则"
    },
    {
      "key": "outline",
      "path": "novel_output/{平台}/{书名}/细纲",
      "purpose": "本章对应细纲目录或卷文件"
    },
    {
      "key": "previous_chapter",
      "path": "{previous_chapter_file}",
      "purpose": "上一章正文"
    },
    {
      "key": "chapter_constraints",
      "path": "novel_creation_promax/references/chapter_constraint_template.md",
      "purpose": "本章约束模板"
    }
  ],
  "routes": [
    {
      "key": "chapter_one",
      "name": "写前立项/第1章",
      "trigger": "chapter == 1",
      "files": [
        "knowledge_base/50_Quality/红线检查/章节前检查.md",
        "knowledge_base/50_Quality/评估系统/评分体系.md"
      ]
    },
    {
      "key": "high_pressure",
      "name": "高压力/反派/暴露场景",
      "trigger": "标题或场景标签命中危机、暴露、反派、逼迫等",
      "files": [
        "knowledge_base/40_Writing/04_场景与描写/潜台词与张力技法.md",
        "knowledge_base/40_Writing/04_场景与描写/爽点设计.md"
      ]
    },
    {
      "key": "dialogue",
      "name": "对话密集",
      "trigger": "标题或场景标签命中对话、交锋、谈判、质问等",
      "files": [
        "knowledge_base/40_Writing/03_人物与对话/对话质感完整框架.md",
        "knowledge_base/40_Writing/03_人物与对话/AI对话丰满化技法.md",
        "knowledge_base/40_Writing/03_人物与对话/乒乓球短句病治疗.md"
      ]
    },
    {
      "key": "rhythm",
      "name": "节奏/卡章/strand 调度",
      "trigger": "需要节奏修复或卡章急救时手动选择",
      "files": [
        "knowledge_base/40_Writing/02_节奏与结构/strand节奏追踪.md",
        "knowledge_base/40_Writing/02_节奏与结构/每章节奏公式与卡章技巧.md"
      ]
    },
    {
      "key": "genre",
      "name": "题材特化",
      "trigger": "项目存在 genre/type/category",
      "files": [
        "knowledge_base/10_WorldBuilding/题材知识库/{题材}.md"
      ]
    },
    {
      "key": "style_drift",
      "name": "风格漂移/降 AI",
      "trigger": "风格校准或 AI 味审计失败后",
      "files": [
        "knowledge_base/40_Writing/05_降AI痕迹/降低AI痕迹.md",
        "knowledge_base/40_Writing/05_降AI痕迹/风格硬约束.md"
      ]
    },
    {
      "key": "opening",
      "name": "开篇章节",
      "trigger": "chapter <= 5",
      "files": [
        "knowledge_base/40_Writing/01_开篇技巧/黄金三章技巧.md",
        "knowledge_base/40_Writing/01_开篇技巧/开头钩子库.md"
      ]
    },
    {
      "key": "short_story",
      "name": "短篇模式",
      "trigger": "短篇/知乎盐选/短故事模式",
      "files": [
        "knowledge_base/40_Writing/07_短篇与模板/短篇创作模板.md"
      ]
    },
    {
      "key": "intimacy",
      "name": "亲密/感情线",
      "trigger": "亲密、告白、暧昧、感情线场景",
      "files": [
        "knowledge_base/40_Writing/04_场景与描写/亲密场景写作指南.md"
      ]
    },
    {
      "key": "engine_project",
      "name": "15维立项命中率",
      "trigger": "立项、评估题材能不能写、爆款命中率",
      "files": [
        "knowledge_base/50_Quality/评估系统/15维爆款命中率.md"
      ]
    },
    {
      "key": "engine_opening",
      "name": "开篇100分卡",
      "trigger": "chapter <= 5 或开篇验收",
      "files": [
        "knowledge_base/40_Writing/01_开篇技巧/开篇100分卡.md"
      ],
      "chapter_max": 5
    },
    {
      "key": "engine_quality",
      "name": "10步量化门禁与16维审稿",
      "trigger": "写后审计失败、投稿前深度审稿",
      "files": [
        "knowledge_base/50_Quality/量化门禁/10步量化门禁.md",
        "knowledge_base/50_Quality/评估系统/16维深度审稿.md"
      ],
      "title_keywords": [
        "审稿",
        "修稿",
        "体检"
      ]
    },
    {
      "key": "engine_continuity",
      "name": "六台账与跨章节奏",
      "trigger": "长篇连载、每5-10章复盘、跨章节奏检查",
      "files": [
        "knowledge_base/30_Plot/六台账与20条毒点.md",
        "knowledge_base/40_Writing/02_节奏与结构/跨章规范与七遍改稿.md",
        "knowledge_base/40_Writing/06_质量校验/章节节奏R1-R8.md",
        "knowledge_base/40_Writing/06_质量校验/长篇实战教训.md"
      ],
      "chapter_mod": 5
    },
    {
      "key": "engine_deai",
      "name": "朱雀祛AI味",
      "trigger": "AI味重、去AI味、过朱雀检测",
      "files": [
        "knowledge_base/40_Writing/05_降AI痕迹/朱雀祛AI味五维.md",
        "knowledge_base/40_Writing/05_降AI痕迹/AI禁用词与句式表.md"
      ],
      "title_keywords": [
        "AI",
        "去AI",
        "降AI",
        "润色"
      ]
    },
    {
      "key": "engine_ops",
      "name": "数据诊断与平台换挡",
      "trigger": "上线后数据差、断流、切书、换平台、书测",
      "files": [
        "knowledge_base/60_Platform/数据诊断与救盘.md",
        "knowledge_base/60_Platform/平台机制与换挡.md"
      ]
    },
    {
      "key": "engine_craft",
      "name": "人物、结构、句式与短剧",
      "trigger": "人物声线、叙事结构、场景节点、句式零件、短剧改编",
      "files": [
        "knowledge_base/20_Characters/人物声线与弧线卡.md",
        "knowledge_base/30_Plot/叙事结构与场景节点.md",
        "knowledge_base/40_Writing/03_人物与对话/句式骨架与提示词库.md",
        "knowledge_base/40_Writing/07_短篇与模板/短剧改编10维.md",
        "knowledge_base/10_WorldBuilding/世界观模板与规则.md"
      ],
      "title_keywords": [
        "人物",
        "对话",
        "结构",
        "短篇",
        "短剧",
        "声线"
      ]
    },
    {
      "key": "engine_insert",
      "name": "插章与重编号",
      "trigger": "插章、扩写、重编号",
      "files": [
        "knowledge_base/40_Writing/06_质量校验/插章与重编号.md"
      ],
      "title_keywords": [
        "插章",
        "重编号"
      ]
    }
  ],
  "evaluations": [
    {
      "stage": "创意立项",
      "file": "knowledge_base/50_Quality/评估系统/创意评估.md"
    },
    {
      "stage": "设定完成",
      "file": "knowledge_base/50_Quality/评估系统/设定评估.md"
    },
    {
      "stage": "大纲完成",
      "file": "knowledge_base/50_Quality/评估系统/大纲评估.md"
    },
    {
      "stage": "卷结构完成",
      "file": "knowledge_base/50_Quality/评估系统/结构评估.md"
    },
    {
      "stage": "每章写后",
      "file": "knowledge_base/50_Quality/评估系统/内容评估.md"
    },
    {
      "stage": "每5-10章复盘",
      "file": "knowledge_base/50_Quality/六编辑审稿系统.md"
    },
    {
      "stage": "上线后",
      "file": "knowledge_base/50_Quality/发布后复盘/发布后复盘指南.md"
    }
  ]
}
