{
  "schema_version": "1.0",
  "purpose": "知识库目录与生命周期契约，避免把收件、生产、归档、机器数据混在同一层。",
  "human_index": "00_Index.md",
  "machine_routes": "_ROUTES.json",
  "legacy_index": "_LEGACY_INDEX.md",
  "domains": [
    {
      "path": "00_Inbox",
      "kind": "inbox",
      "lifecycle": "transient",
      "policy": "新素材临时落点；完成归类后必须移出，保留 README 和待处理清单。"
    },
    {
      "path": "10_WorldBuilding",
      "kind": "reference",
      "lifecycle": "active",
      "policy": "世界观、题材与流派知识；被路由引用的文件优先保持稳定路径。"
    },
    {
      "path": "15_Ideas",
      "kind": "ideas",
      "lifecycle": "mixed",
      "policy": "新创意按平台/题材归档；历史大批量资料暂不移动，必须通过 archive 子树隔离。"
    },
    {
      "path": "20_Characters",
      "kind": "reference",
      "lifecycle": "active",
      "policy": "通用角色设计知识，不放单本小说的角色状态。"
    },
    {
      "path": "30_Plot",
      "kind": "reference",
      "lifecycle": "active",
      "policy": "通用剧情、结构和伏笔方法，不放单本小说的运行状态。"
    },
    {
      "path": "40_Writing",
      "kind": "reference",
      "lifecycle": "active",
      "policy": "写作技法、风格和工作流；旧分类只能通过 _LEGACY_INDEX.md 访问。"
    },
    {
      "path": "50_Quality",
      "kind": "governance",
      "lifecycle": "active",
      "policy": "质量门、评估、发布后复盘和知识库治理。"
    },
    {
      "path": "60_Platform",
      "kind": "reference",
      "lifecycle": "active",
      "policy": "平台规则和商业信息；带年份的资料必须标注有效期。"
    },
    {
      "path": "70_Corpus",
      "kind": "corpus",
      "lifecycle": "active",
      "policy": "可检索语料和反馈，不直接作为事实源或项目状态。"
    },
    {
      "path": "80_Projects",
      "kind": "project",
      "lifecycle": "active",
      "policy": "每本小说独立目录；项目编号漂移通过 _PROJECT_ALIASES.json 解决，不直接改历史目录。",
      "required_files": ["_config.md", "项目索引.md", "变更记录.md"],
      "required_dirs": ["伏笔追踪", "角色状态", "剧情节点"]
    },
    {
      "path": "space",
      "kind": "vault",
      "lifecycle": "active",
      "policy": "Ship-Learn-Next 原生创作空间；found 收集内容，crafted 原创内容，_templates 只放模板。"
    },
    {
      "path": "flux",
      "kind": "raw",
      "lifecycle": "transient",
      "policy": "抓取原文和中间数据，默认 Git 忽略，不作为创作路由输入。"
    },
    {
      "path": "90_Archive",
      "kind": "archive",
      "lifecycle": "archive",
      "policy": "历史资料只读保存，不进入默认知识路由；迁移前必须扫描引用。"
    }
  ],
  "archive_subtrees": [
    {
      "path": "90_Archive/惊鸿归档",
      "reason": "历史项目与旧脚本体量较大。",
      "target": "只读保留，不进入默认路由。"
    },
    {
      "path": "90_Archive/40_Writing_写作技巧",
      "reason": "旧写作分类已由阶段目录替代。",
      "target": "新内容只进入 01_开篇技巧 至 07_短篇与模板。"
    }
  ],
  "project_overrides": [
    {
      "path": "80_Projects/我替死者接了三年电话",
      "lifecycle": "knowledge_only",
      "contract": "minimal",
      "reason": "只有历史配置，没有对应 novel_output，不创建空项目骨架。"
    }
  ]
}
